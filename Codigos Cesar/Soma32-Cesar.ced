; Soma de duas variaveis de 32 bits (cada uma em duas palavras)
org 1024
HI1: dw 1             ; var1: parte alta
LO1: dw 60000         ; var1: parte baixa  (var1 = 1 x 65536 + 60000)
HI2: dw 2             ; var2: parte alta
LO2: dw 10000         ; var2: parte baixa  (var2 = 2 x 65536 + 10000)
RHI: dw 0             ; resultado: parte alta
RLO: dw 0             ; resultado: parte baixa

org 0
    MOV 1026, R0      ; R0 = parte baixa de var1
    ADD 1030, R0      ; soma a parte baixa de var2 (C = 1 se estourar 16 bits)
    MOV R0, 1034      ; salva a parte baixa do resultado
    MOV #0, R0        ; zera R0 (MOV nao altera o carry)
    ADC R0            ; R0 = R0 + carry (vai um da soma anterior)
    ADD 1024, R0      ; soma a parte alta de var1
    ADD 1028, R0      ; soma a parte alta de var2
    MOV R0, 1032      ; salva a parte alta do resultado
    HLT