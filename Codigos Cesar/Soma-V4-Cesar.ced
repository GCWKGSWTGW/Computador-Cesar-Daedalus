; Versao 4 - instrucao SOB
org 0
    CLR R0
    MOV 1026, R2
    MOV 1024, R1
    BEQ FIM
LACO:
    ADD (R2)+, R0
    SOB R1, LACO      ; R1 - 1; se diferente de zero, volta ao laco
FIM:
    MOV R0, 1028
    HLT

org 1024
TAM:    dw 5
ENDINI: dw 1030
TOTAL:  dw 0

org 1030
    dw 10
    dw 20
    dw 30
    dw 40
    dw 50