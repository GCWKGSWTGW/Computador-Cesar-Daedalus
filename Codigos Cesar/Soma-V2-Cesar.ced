; Versao 2 - BNE no final do laco
org 0
    CLR R0
    MOV 1026, R2
    MOV 1024, R1
    BEQ FIM           ; testa n = 0 uma unica vez, antes do laco
LACO:
    ADD (R2), R0
    ADD #2, R2
    DEC R1
    BNE LACO          ; repete enquanto o contador nao zerar
FIM:
    MOV R0, 1028
    HLT

org 1024
TAM:    dw 5
ENDINI: dw 1030
TOTAL:  dw 0

org 1030
    dw 10
    dw 20
    dw 30
    dw 40
    dw 50